{
  "name": "qqbot",
  "private": true,
  "version": "0.1.0",
  "description": "QQ chat bot on NapCat: jev decides when to speak, deepseek-flash decides what to say",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mist-wu/qqbot.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "learn-history": "node dist/cli/learn-history.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.6.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
