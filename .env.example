# NapCat OneBot v11 正向 WebSocket（NapCat 做服务端，bot 做客户端）
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
# 两条消息之间的最小发送间隔，防止触发风控
NAPCAT_SEND_INTERVAL_MS=800

# 机器人
BOT_NAME=小猫
# 群友对机器人的其他称呼，逗号分隔
BOT_ALIASES=
BOT_PERSONA=是群里的一员。
# 启用的群号，逗号分隔；为空时不在任何群发言
BOT_GROUPS=
# 允许私聊的 QQ 号，逗号分隔；为空时不回任何私聊
BOT_PRIVATE_USERS=

# jev（TypeSafe AI）：决定该不该发言、要不要给 DeepSeek 挂上联网搜索
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000

# 判断阈值：jev 给出的“该回复”概率达到阈值才发言
GATE_GROUP_THRESHOLD=0.6
GATE_PRIVATE_THRESHOLD=0.35
# 被 @ 或被回复时的阈值（仍由 jev 判断，“哈哈哈”之类的可以不回）
GATE_DIRECT_THRESHOLD=0.3
# jev 的 needs_search 高于这个值就挂上 web_search 工具，搜不搜由 DeepSeek 决定
GATE_SEARCH_THRESHOLD=0.1
# 等消息停下来再判断，把连续几条合并成一批
GATE_GROUP_DEBOUNCE_MS=3000
GATE_PRIVATE_DEBOUNCE_MS=1500
GATE_DIRECT_DEBOUNCE_MS=800
GATE_MAX_WAIT_MS=10000

# DeepSeek（固定使用 deepseek-flash）
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=800
DEEPSEEK_MAX_TOOL_ROUNDS=3

# 联网搜索：只用 Codex 凭证。在本机运行 deploy/sync-codex-auth.sh 把 pi 的 access token 同步过来（不含 refresh token）
SEARCH_ENABLED=true
CODEX_AUTH_FILE=data/codex-auth.json
CODEX_SEARCH_MODEL=gpt-5.6-luna
CODEX_SEARCH_CONTEXT_SIZE=medium

# 表情包：收藏群友发的表情包，deepseek-flash 识图描述
STICKERS_ENABLED=true
STICKERS_DIR=data/stickers
STICKERS_MAX=300
STICKERS_PROMPT_LIMIT=40

# 长期记忆：bot 回复后等对话停下再整理，或未整理的消息攒够一批时整理
MEMORY_ENABLED=true
MEMORY_FILE=data/memory.json
MEMORY_LEARN_DELAY_MS=10000
MEMORY_LEARN_BATCH=30
MEMORY_MAX_FACTS=20

# 只防失控输出的上限，提示词里不限制长度
REPLY_MAX_CHARS=1500
REPLY_MAX_PARTS=8
HISTORY_CONTEXT_MESSAGES=20
LOG_LEVEL=info
